// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum UserRole {
  ADMIN
  MITRA
  CUSTOMER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  WAITING_PAYMENT
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SETTLEMENT
  EXPIRED
  FAILED
  REFUNDED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// --- MODELS ---

model User {
  id            Int        @id @default(autoincrement())
  email         String        @unique
  password      String
  name          String
  role          UserRole      @default(CUSTOMER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  mitraProfile  MitraProfile? 
  userProfile   UserProfile?
  bookings      Booking[]
  reviews       Review[]
  chatRooms        ChatRoom[]    @relation("CustomerRooms")
  sentMessages     ChatMessage[]
}

model UserProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id])
  
  phone       String?  @db.VarChar(20)
  nik         String?  @db.VarChar(20)
  address     String?  @db.Text
  avatarUrl   String?  @db.VarChar(255)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MitraProfile {
  id                Int           @id @default(autoincrement())
  userId            Int           @unique
  user              User             @relation(fields: [userId], references: [id])
  
  // Info Bisnis
  shopName          String
  address           String           @db.Text
  description       String?
  latitude          Float?
  longitude         Float?
  
  // Data Verifikasi (Approval)
  nik               String           @unique
  npwp              String?          @unique
  identityPhoto     String           @db.VarChar(255)
  approvalStatus    ApprovalStatus   @default(PENDING)
  rejectionReason   String?          @db.Text

  // Fitur Buka/Tutup daddakan
  isManualClosed    Boolean          @default(false)
  manualCloseReason String?          @db.Text

  // Relasi
  operatingHours    OperatingHour[]
  units             PlaystationUnit[]
  snacks            Snack[]
  bookings          Booking[]
  reviews           Review[]
  photos            MitraPhoto[]
  chatRooms        ChatRoom[]

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model MitraPhoto {
  id             Int       @id @default(autoincrement())
  mitraId        Int
  mitra          MitraProfile @relation(fields: [mitraId], references: [id])
  
  photoUrl       String       @db.VarChar(255) // URL dari Cloudinary/S3/Local Storage
  isMain         Boolean      @default(false)  // Untuk foto sampul utama
  caption        String?      @db.VarChar(100) // Contoh: "Area VIP", "Parkir Luas"

  createdAt      DateTime     @default(now())
}

model OperatingHour {
  id          Int       @id @default(autoincrement())
  mitraId     Int
  mitra       MitraProfile @relation(fields: [mitraId], references: [id])

  day         DayOfWeek
  openTime    String       // Contoh: "08:00"
  closeTime   String       // Contoh: "22:00"
  isOpen      Boolean      @default(true)

  @@unique([mitraId, day])
}

model PlaystationUnit {
  id           Int          @id @default(autoincrement())
  mitraId      Int
  mitra        MitraProfile    @relation(fields: [mitraId], references: [id])
  
  name         String          // Contoh: "PS5 VIP 01"
  type         String          // Contoh: "PS5", "PS4"
  pricePerHour Decimal         @db.Decimal(12, 2)
  isAvailable  Boolean         @default(true) // Untuk maintenance unit tertentu

  bookings     Booking[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Snack {
  id           Int          @id @default(autoincrement())
  mitraId      Int
  mitra        MitraProfile    @relation(fields: [mitraId], references: [id])
  
  name         String
  price        Decimal         @db.Decimal(12, 2)
  stock        Int             @default(0)

  orderItems   BookingSnack[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Booking {
  id           Int          @id @default(autoincrement())
  userId       Int
  user         User            @relation(fields: [userId], references: [id])
  
  mitraId      Int
  mitra        MitraProfile    @relation(fields: [mitraId], references: [id])

  unitId       Int
  unit         PlaystationUnit @relation(fields: [unitId], references: [id])

  // DATA DIRI PENYEWA (Untuk Jaminan/Bukti ke Mitra)
  renterName   String          // Nama sesuai identitas
  renterNik    String          // NIK KTP penyewa
  renterPhone  String          // Nomor HP aktif saat booking
  renterPhoto  String?         @db.VarChar(255) // Optional: Foto KTP penyewa jika diwajibkan

  // Waktu & Durasi
  startTime    DateTime
  endTime      DateTime
  durationHour Int
  
  // Total & Status
  totalPrice   Decimal         @db.Decimal(12, 2)
  status       BookingStatus   @default(WAITING_PAYMENT)

  // Relations
  payment      Payment?
  snacks       BookingSnack[]
  review       Review?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([startTime, endTime])
}

model BookingSnack {
  id             Int  @id @default(autoincrement())
  bookingId      Int
  booking        Booking @relation(fields: [bookingId], references: [id])
  
  snackId        Int
  snack          Snack   @relation(fields: [snackId], references: [id])
  
  quantity       Int
  priceAtBooking Decimal @db.Decimal(12, 2)
}

model Payment {
  id                Int        @id @default(autoincrement())
  bookingId         Int        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id])
  
  externalId        String?       @unique // ID dari Payment Gateway (Midtrans/Xendit)
  amount            Decimal       @db.Decimal(12, 2)
  status            PaymentStatus @default(PENDING)
  checkoutUrl       String?       @db.Text
  
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Review {
  id           Int       @id @default(autoincrement())
  bookingId    Int       @unique
  booking      Booking      @relation(fields: [bookingId], references: [id])
  
  userId       Int
  user         User         @relation(fields: [userId], references: [id])
  
  mitraId      Int
  mitra        MitraProfile @relation(fields: [mitraId], references: [id])

  rating       Int          // Skala 1-5
  comment      String?      @db.Text
  
  createdAt    DateTime     @default(now())
}


// fitur chat real time socket io
model ChatRoom {
  id         Int           @id @default(autoincrement())
  customerId Int           // Menyimpan ID User yang rolenya CUSTOMER
  customer   User          @relation("CustomerRooms", fields: [customerId], references: [id])
  
  mitraId    Int           // Menyimpan ID dari MitraProfile
  mitra      MitraProfile  @relation(fields: [mitraId], references: [id])

  // Relasi balik ke tabel pesan (Satu room punya banyak pesan)
  messages   ChatMessage[]

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

    // Kunci unik gabungan agar 1 Customer dan 1 Mitra hanya punya maksimal 1 Room Chat yang sama
  @@unique([customerId, mitraId]) 
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  roomId     Int      // Menghubungkan pesan ke Room mana
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  senderId   Int      // Menyimpan ID User pengirim pesan (bisa Mitra / Customer)
  sender     User     @relation(fields: [senderId], references: [id])
  
  message    String   @db.Text
  isRead     Boolean  @default(false) // Untuk fitur tanda centang biru / belum dibaca

  createdAt  DateTime @default(now())
}