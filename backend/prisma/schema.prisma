// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum UserRole {
  ADMIN
  MITRA
  CUSTOMER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  WAITING_PAYMENT
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SETTLEMENT
  EXPIRED
  FAILED
  REFUNDED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// --- MODELS ---

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  emailVerified Boolean       @default(false)
  image         String?       @db.Text
  password      String?       @db.Text
  role          UserRole      @default(CUSTOMER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Better Auth Relations
  sessions      Session[]
  accounts      Account[]

  // Existing Relations
  mitraProfile  MitraProfile? 
  userProfile   UserProfile?
  bookings      Booking[]
  reviews       Review[]
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.Text
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String    @id @default(uuid())
  identifier String    @db.Text
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model UserProfile {
  id          Int      @id @default(autoincrement())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  
  phone       String?  @db.VarChar(20)
  nik         String?  @db.VarChar(20)
  address     String?  @db.Text
  avatarUrl   String?  @db.VarChar(255)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MitraProfile {
  id                Int           @id @default(autoincrement())
  userId            String        @unique
  user              User          @relation(fields: [userId], references: [id])
  
  // Info Bisnis
  shopName          String
  address           String           @db.Text
  description       String?
  latitude          Float?
  longitude         Float?
  
  // Data Verifikasi (Approval)
  nik               String           @unique
  npwp              String?          @unique
  identityPhoto     String           @db.VarChar(255)
  approvalStatus    ApprovalStatus   @default(PENDING)
  rejectionReason   String?          @db.Text

  // Fitur Buka/Tutup daddakan
  isManualClosed    Boolean          @default(false)
  manualCloseReason String?          @db.Text

  // Relasi
  operatingHours    OperatingHour[]
  units             PlaystationUnit[]
  snacks            Snack[]
  bookings          Booking[]
  reviews           Review[]
  photos            MitraPhoto[]

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model MitraPhoto {
  id             Int       @id @default(autoincrement())
  mitraId        Int
  mitra          MitraProfile @relation(fields: [mitraId], references: [id])
  
  photoUrl       String       @db.VarChar(255) // URL dari Cloudinary/S3/Local Storage
  isMain         Boolean      @default(false)  // Untuk foto sampul utama
  caption        String?      @db.VarChar(100) // Contoh: "Area VIP", "Parkir Luas"

  createdAt      DateTime     @default(now())
}

model OperatingHour {
  id          Int       @id @default(autoincrement())
  mitraId     Int
  mitra       MitraProfile @relation(fields: [mitraId], references: [id])

  day         DayOfWeek
  openTime    String       // Contoh: "08:00"
  closeTime   String       // Contoh: "22:00"
  isOpen      Boolean      @default(true)

  @@unique([mitraId, day])
}

model PlaystationUnit {
  id           Int          @id @default(autoincrement())
  mitraId      Int
  mitra        MitraProfile    @relation(fields: [mitraId], references: [id])
  
  name         String          // Contoh: "PS5 VIP 01"
  type         String          // Contoh: "PS5", "PS4"
  pricePerHour Decimal         @db.Decimal(12, 2)
  isAvailable  Boolean         @default(true) // Untuk maintenance unit tertentu

  bookings     Booking[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Snack {
  id           Int          @id @default(autoincrement())
  mitraId      Int
  mitra        MitraProfile    @relation(fields: [mitraId], references: [id])
  
  name         String
  price        Decimal         @db.Decimal(12, 2)
  stock        Int             @default(0)

  orderItems   BookingSnack[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Booking {
  id           Int          @id @default(autoincrement())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  
  mitraId      Int
  mitra        MitraProfile @relation(fields: [mitraId], references: [id])

  unitId       Int
  unit         PlaystationUnit @relation(fields: [unitId], references: [id])

  // DATA DIRI PENYEWA (Untuk Jaminan/Bukti ke Mitra)
  renterName   String          // Nama sesuai identitas
  renterNik    String          // NIK KTP penyewa
  renterPhone  String          // Nomor HP aktif saat booking
  renterPhoto  String?         @db.VarChar(255) // Optional: Foto KTP penyewa jika diwajibkan

  // Waktu & Durasi
  startTime    DateTime
  endTime      DateTime
  durationHour Int
  
  // Total & Status
  totalPrice   Decimal         @db.Decimal(12, 2)
  status       BookingStatus   @default(WAITING_PAYMENT)

  // Relations
  payment      Payment?
  snacks       BookingSnack[]
  review       Review?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([startTime, endTime])
}

model BookingSnack {
  id             Int  @id @default(autoincrement())
  bookingId      Int
  booking        Booking @relation(fields: [bookingId], references: [id])
  
  snackId        Int
  snack          Snack   @relation(fields: [snackId], references: [id])
  
  quantity       Int
  priceAtBooking Decimal @db.Decimal(12, 2)
}

model Payment {
  id                Int        @id @default(autoincrement())
  bookingId         Int        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id])
  
  externalId        String?       @unique // ID dari Payment Gateway (Midtrans/Xendit)
  amount            Decimal       @db.Decimal(12, 2)
  status            PaymentStatus @default(PENDING)
  checkoutUrl       String?       @db.Text
  
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Review {
  id           Int       @id @default(autoincrement())
  bookingId    Int       @unique
  booking      Booking      @relation(fields: [bookingId], references: [id])
  
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  
  mitraId      Int
  mitra        MitraProfile @relation(fields: [mitraId], references: [id])

  rating       Int          // Skala 1-5
  comment      String?      @db.Text
  
  createdAt    DateTime     @default(now())
}